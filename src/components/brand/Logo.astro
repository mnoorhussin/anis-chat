---
import { getLangFromUrl } from '@i18n/utils';

interface Props {
  /** Show the wordmark next to the mark. */
  wordmark?: boolean;
  /** Extra classes on the wrapper. */
  class?: string;
  /** Tailwind size classes for the mark svg (default h-8 w-8). */
  markClass?: string;
  /** Tailwind size class for the wordmark text (default text-xl). */
  textClass?: string;
}

const {
  wordmark = true,
  class: className = '',
  markClass = 'h-8 w-8',
  textClass = 'text-xl',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

{/*
  The mark: three i‘jām dots — the dot-cluster that crowns ث/ش. It is at once
  Arabic-script-native, a “typing…” indicator, and the pause before a
  considered answer. Ink tile, saffron dots. See docs/DESIGN-DIRECTION.md §3.1.
*/}
<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    class:list={[markClass, 'shrink-0']}
    viewBox="0 0 40 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <rect x="2" y="2" width="36" height="36" rx="10" class="fill-ink" style="fill: var(--color-ink);"></rect>
    <circle cx="20" cy="14.5" r="4" fill="#E3A84E"></circle>
    <circle cx="13.5" cy="25.5" r="4" fill="#E3A84E"></circle>
    <circle cx="26.5" cy="25.5" r="4" fill="#E3A84E"></circle>
  </svg>
  {
    wordmark ? (
      <span class:list={['inline-flex flex-col leading-none', textClass]}>
        {/* Arabic always leads — on every page, both locales. It IS the brand. */}
        <span class="font-[Amiri] font-bold text-current" dir="rtl">
          أنيس
        </span>
        {lang !== 'ar' && (
          <span class="mt-0.5 text-[0.5em] font-medium tracking-[0.18em] text-muted uppercase">
            Anis
          </span>
        )}
      </span>
    ) : (
      <span class="sr-only">Anis — أنيس</span>
    )
  }
</span>
