---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, getDict } from '@i18n/utils';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const m = getDict(lang).mocks.install;

const snippet = '<script src="https://cdn.anis.chat/widget.js" data-id="anis_x8f2" defer></' + 'script>';
---

<div
  class:list={[
    'w-full overflow-hidden rounded-2xl border border-border-soft bg-surface text-foreground shadow-lifted',
    className,
  ]}
  dir="ltr"
>
  <div class="flex items-center gap-2 border-b border-border-soft px-4 py-2.5">
    <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
    <span class="ms-2 font-mono text-[11px] text-subtle">index.html</span>
  </div>

  <div class="p-4 sm:p-5">
    <pre class="overflow-x-auto font-mono text-[10.5px] leading-relaxed sm:text-[12px]"><code><span class="text-subtle">&lt;</span><span class="text-[#ff8fab]">script</span> <span class="text-oasis">src</span><span class="text-subtle">=</span><span class="text-oasis-bright">"https://cdn.anis.chat/widget.js"</span> <span class="text-oasis">data-id</span><span class="text-subtle">=</span><span class="text-oasis-bright">"anis_x8f2"</span> <span class="text-oasis">defer</span><span class="text-subtle">&gt;&lt;/</span><span class="text-[#ff8fab]">script</span><span class="text-subtle">&gt;</span></code></pre>

    <div class="mt-4 flex items-center justify-between border-t border-border-soft pt-3">
      <span class="flex items-center gap-1.5 text-[12px] text-muted">
        <Icon name="lucide:sparkles" class="h-3.5 w-3.5 text-oasis" />
        {m.note}
      </span>
      <button
        type="button"
        data-copy={snippet}
        data-copied-label={m.copied}
        class="inline-flex items-center gap-1.5 rounded-lg border border-border-soft px-3 py-1.5 text-[12px] font-medium text-foreground transition-colors hover:bg-surface-2"
      >
        <Icon name="lucide:copy" class="h-3.5 w-3.5" />
        <span data-copy-label>{m.copy}</span>
      </button>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest ? e.target.closest('[data-copy]') : null;
    if (!btn) return;
    var text = btn.getAttribute('data-copy');
    var label = btn.querySelector('[data-copy-label]');
    var done = btn.getAttribute('data-copied-label') || 'Copied';
    var orig = label ? label.textContent : '';
    function flash() {
      if (label) {
        label.textContent = done;
        setTimeout(function () {
          label.textContent = orig;
        }, 1600);
      }
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(flash, flash);
    } else {
      flash();
    }
  });
</script>
