---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, getDict } from '@i18n/utils';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const inbox = getDict(lang).mocks.inbox;

const channelIcon: Record<string, string> = {
  whatsapp: 'simple-icons:whatsapp',
  messenger: 'simple-icons:messenger',
  instagram: 'simple-icons:instagram',
  web: 'lucide:globe',
};
// The thread pane mirrors this row.
const selected = 1;
---

<div
  class:list={[
    'w-full overflow-hidden rounded-2xl border border-white/10 bg-[#0b0b12] text-white shadow-[0_30px_80px_-28px_rgba(0,0,0,0.85)]',
    className,
  ]}
>
  {/* window bar */}
  <div class="flex items-center gap-2 border-b border-white/[0.07] px-4 py-3">
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span class="ms-3 hidden rounded-md bg-white/[0.05] px-3 py-1 text-[11px] text-white/40 sm:inline-block">
      app.anis.chat
    </span>
  </div>

  <div class="flex">
    {/* conversation list */}
    <div class="w-full shrink-0 border-e border-white/[0.07] md:w-[42%]">
      <div class="flex items-center justify-between gap-2 px-4 py-3.5">
        <h4 class="text-sm font-semibold text-white">{inbox.title}</h4>
        <div class="flex items-center gap-1.5">
          <span class="rounded-full bg-white/[0.08] px-2.5 py-1 text-[10px] font-medium text-white/70">
            {inbox.filterAll}
          </span>
          <span class="hidden rounded-full px-2.5 py-1 text-[10px] font-medium text-white/40 lg:inline-block">
            {inbox.filterAi}
          </span>
        </div>
      </div>

      <div class="flex flex-col pb-2">
        {
          inbox.list.map((c, i) => (
            <div
              class:list={[
                'flex items-center gap-3 border-s-2 px-4 py-3',
                i === selected
                  ? 'border-s-iris bg-iris/[0.1]'
                  : 'border-s-transparent',
              ]}
            >
              <span
                class:list={[
                  'grid h-8 w-8 shrink-0 place-items-center rounded-full text-[11px] font-semibold',
                  i === selected
                    ? 'bg-[image:var(--gradient-brand)] text-white'
                    : 'bg-white/[0.08] text-white/70',
                ]}
              >
                {c.name.slice(0, 1)}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5">
                  <p dir="auto" class="truncate text-[12px] font-medium text-white/90">{c.name}</p>
                  <Icon name={channelIcon[c.channel]} class="h-3 w-3 shrink-0 text-white/30" />
                </div>
                <p dir="auto" class="mt-0.5 truncate text-[11px] text-white/45">{c.snippet}</p>
              </div>
              <span class="shrink-0 text-[10px] text-white/30">{c.time}</span>
            </div>
          ))
        }
      </div>
    </div>

    {/* thread */}
    <div class="hidden min-w-0 flex-1 flex-col md:flex">
      <div class="flex items-center justify-between gap-3 border-b border-white/[0.07] px-5 py-3">
        <div class="min-w-0">
          <p dir="auto" class="truncate text-[13px] font-semibold text-white">{inbox.thread.name}</p>
          <p class="truncate text-[11px] text-white/40">{inbox.thread.channelLabel}</p>
        </div>
        <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-aqua/15 px-2.5 py-1 text-[10px] font-medium text-aqua">
          <Icon name="lucide:sparkles" class="h-3 w-3" />
          {inbox.thread.aiBadge}
        </span>
      </div>

      <div class="flex flex-1 flex-col gap-3 px-5 py-5">
        {
          inbox.thread.messages.map((m) =>
            m.from === 'user' ? (
              <div
                dir="auto"
                class="max-w-[80%] self-end rounded-2xl rounded-ee-md bg-white/[0.08] px-3.5 py-2 text-[12px] leading-relaxed text-white/90"
              >
                {m.text}
              </div>
            ) : (
              <div
                dir="auto"
                class="max-w-[85%] self-start rounded-2xl rounded-ss-md border border-iris/25 bg-iris/[0.12] px-3.5 py-2 text-[12px] leading-relaxed text-white"
              >
                {m.text}
              </div>
            ),
          )
        }
      </div>

      <div class="flex items-center gap-2 border-t border-white/[0.07] px-5 py-3">
        <Icon name="lucide:zap" class="h-3.5 w-3.5 shrink-0 text-aqua" />
        <p class="truncate text-[11px] text-white/45">{inbox.thread.handoff}</p>
      </div>
    </div>
  </div>
</div>
