---
import { Icon } from 'astro-icon/components';
import Logo from '@components/brand/Logo.astro';
import Button from '@components/ui/Button.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getLangFromUrl, getDict } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
const home = `/${lang}/`;

const links = [
  { label: t.nav.links.features, href: '#features' },
  { label: t.nav.links.how, href: '#how' },
  { label: t.nav.links.useCases, href: '#use-cases' },
  { label: t.nav.links.agencies, href: '#agencies' },
  { label: t.nav.links.pricing, href: '#pricing' },
  { label: t.nav.links.faq, href: '#faq' },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-3 sm:pt-4" data-navbar>
  <div class="container-page !px-0">
    <div
      data-nav-pill
      class="glass mx-auto flex items-center justify-between gap-3 rounded-full border border-border-soft px-3 py-2 shadow-soft transition-shadow duration-300 sm:px-4"
    >
      <a href={home} class="flex items-center rounded-full text-foreground" aria-label="Anis — home">
        <Logo markClass="h-7 w-7" textClass="text-lg" />
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="rounded-full px-3.5 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-foreground"
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <ThemeToggle />
        <div class="hidden items-center gap-2 sm:flex">
          <LanguageSwitcher />
          <Button href="#waitlist" size="sm">{t.nav.cta}</Button>
        </div>
        <button
          type="button"
          data-menu-btn
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t.nav.openMenu}
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border-soft text-foreground transition-colors hover:bg-surface-2 lg:hidden"
        >
          <Icon name="lucide:menu" class="menu-open-icon h-5 w-5" />
          <Icon name="lucide:x" class="menu-close-icon hidden h-5 w-5" />
        </button>
      </div>
    </div>

    {/* Mobile menu */}
    <div
      id="mobile-menu"
      data-mobile-menu
      hidden
      class="glass mx-auto mt-2 origin-top rounded-3xl border border-border-soft p-3 shadow-lifted lg:hidden"
    >
      <nav class="flex flex-col" aria-label="Mobile">
        {
          links.map((l) => (
            <a
              href={l.href}
              data-menu-link
              class="rounded-2xl px-4 py-3 text-base font-medium text-foreground transition-colors hover:bg-surface-2"
            >
              {l.label}
            </a>
          ))
        }
      </nav>
      <div class="mt-2 flex items-center justify-between gap-3 border-t border-border-soft px-2 pt-3">
        <LanguageSwitcher />
        <Button href="#waitlist" size="sm" data-menu-link class="flex-1 justify-center">{t.nav.cta}</Button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('[data-menu-btn]');
    var menu = document.querySelector('[data-mobile-menu]');
    if (!btn || !menu) return;
    var openIcon = btn.querySelector('.menu-open-icon');
    var closeIcon = btn.querySelector('.menu-close-icon');

    function setOpen(open) {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      if (openIcon) openIcon.classList.toggle('hidden', open);
      if (closeIcon) closeIcon.classList.toggle('hidden', !open);
    }
    btn.addEventListener('click', function () {
      setOpen(menu.hidden);
    });
    menu.querySelectorAll('[data-menu-link]').forEach(function (l) {
      l.addEventListener('click', function () {
        setOpen(false);
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        btn.focus();
      }
    });

    // Subtle scroll polish on the pill
    var pill = document.querySelector('[data-nav-pill]');
    function onScroll() {
      if (!pill) return;
      if (window.scrollY > 8) pill.classList.add('shadow-lifted');
      else pill.classList.remove('shadow-lifted');
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
