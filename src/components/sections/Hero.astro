---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import { getLangFromUrl, getDict } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
const h = t.hero;
const isAr = lang === 'ar';
---

{/* Paper hero — editorial, typographically led. No glass, no glow, no dark panel. */}
<section class="relative isolate overflow-hidden">
  <div
    class="container-page grid gap-14 pb-20 pt-32 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16 lg:pb-28 lg:pt-40"
  >
    {/* Copy */}
    <div class="flex flex-col items-start">
      <span
        class:list={[
          'inline-flex items-center gap-2.5 text-sm font-semibold text-accent-warm',
          !isAr && 'uppercase tracking-wider',
        ]}
      >
        <span class="ijam" aria-hidden="true"><i></i><i></i><i></i></span>
        {h.badge}
      </span>

      <h1 class="mt-6 text-display-2xl text-foreground">
        {h.titleTop}{' '}<span class="text-gradient underline-hand">{h.titleAccent}</span>{h.titleEnd}
      </h1>

      <p class="mt-7 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">
        {h.lead}
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href="#waitlist" size="lg" trailingArrow>{t.common.getEarlyAccess}</Button>
        <Button href="#waitlist" size="lg" variant="secondary" icon="lucide:calendar">
          {t.common.bookDemo}
        </Button>
      </div>

      {/* capability chips — the core promise, not unverified metrics */}
      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
        {
          h.chips.map((chip) => (
            <span class="inline-flex items-center gap-2 text-sm font-medium text-foreground">
              <span class="grid h-7 w-7 place-items-center rounded-lg" style="background: var(--color-saffron-tint);">
                <Icon name={`lucide:${chip.icon}`} class="h-4 w-4" style="color: var(--color-saffron-ink);" />
              </span>
              {chip.label}
            </span>
          ))
        }
      </div>

      <p class="mt-8 flex items-start gap-2.5 border-t border-border-soft pt-6 text-sm text-muted">
        <Icon name="lucide:globe" class="mt-0.5 h-4 w-4 shrink-0 text-oasis" />
        {h.trustLine}
      </p>
    </div>

    {/* Chat-widget mock — an index card on the desk */}
    <div class="relative mx-auto w-full max-w-md lg:mx-0 lg:ms-auto" data-reveal>
      <div
        class="relative z-10 overflow-hidden rounded-3xl border border-border-strong bg-surface shadow-lifted"
      >
        {/* widget header */}
        <div class="flex items-center gap-3 border-b border-border-soft px-4 py-3.5">
          <span
            class="grid h-9 w-9 shrink-0 place-items-center rounded-xl"
            style="background: var(--color-ink);"
          >
            <svg viewBox="0 0 40 40" class="h-[20px] w-[20px]" aria-hidden="true">
              <circle cx="20" cy="12" r="4.5" fill="#E3A84E"></circle>
              <circle cx="12.5" cy="25" r="4.5" fill="#E3A84E"></circle>
              <circle cx="27.5" cy="25" r="4.5" fill="#E3A84E"></circle>
            </svg>
          </span>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-foreground">{h.chat.header}</p>
            <p class="flex items-center gap-1.5 text-xs text-muted">
              <span class="h-1.5 w-1.5 rounded-full bg-oasis"></span>
              {h.chat.status}
            </p>
          </div>
          <div class="ms-auto flex items-center gap-1.5 text-border-strong" aria-hidden="true">
            <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
            <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
            <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
          </div>
        </div>

        {/* messages */}
        <div class="flex flex-col gap-3.5 px-4 py-5">
          <div
            class="max-w-[80%] self-end rounded-2xl rounded-ee-md bg-surface-3 px-4 py-2.5 text-sm leading-relaxed text-foreground"
          >
            {h.chat.customer}
          </div>
          <div
            class="max-w-[86%] self-start rounded-2xl rounded-ss-md border border-oasis/25 px-4 py-2.5 text-sm leading-relaxed text-foreground"
            style="background: color-mix(in oklab, var(--color-oasis) 8%, var(--surface));"
          >
            {h.chat.agent}
          </div>
          {/* Anis is typing — the i‘jām dots, animated: the logo at work */}
          <div class="self-start px-1" aria-label={h.chat.typing} style="color: var(--color-saffron-ink);">
            <span class="ijam ijam-animated" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
        </div>

        {/* input */}
        <div class="px-3 pb-3">
          <div
            class="flex items-center gap-2 rounded-2xl border border-border-soft bg-surface-2 py-1.5 pe-1.5 ps-4"
          >
            <span class="flex-1 truncate text-sm text-subtle">{h.chat.inputPlaceholder}</span>
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-xl bg-oasis">
              <Icon name="lucide:arrow-up" class="h-4 w-4 text-cream" />
            </span>
          </div>
        </div>
      </div>

      {/* the desk: a second sheet peeking from behind */}
      <div
        class="absolute -bottom-3 start-4 end-[-0.75rem] top-6 -z-10 rounded-3xl border border-border-soft bg-surface-2"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>

  {/* double manuscript rule closing the hero */}
  <div class="container-page" aria-hidden="true">
    <div class="rule-double"></div>
  </div>
</section>
