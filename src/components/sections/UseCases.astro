---
import { Icon } from 'astro-icon/components';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import InboxMock from '@components/mocks/InboxMock.astro';
import { getLangFromUrl, getDict } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
---

<Section id="use-cases" class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-x-0 top-1/4 -z-10 mx-auto h-[32rem] max-w-4xl rounded-full opacity-60"
    style="background: radial-gradient(ellipse at center, rgba(55,224,200,0.13), transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <SectionHeading eyebrow={t.useCases.eyebrow} title={t.useCases.title} />

  {/* Inbox: every channel, every language, one place */}
  <div data-reveal class="relative mx-auto mt-14 max-w-5xl">
    <div
      class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] opacity-80"
      style="background: radial-gradient(ellipse at 50% 0%, rgba(90,90,240,0.18), transparent 60%);"
      aria-hidden="true"
    >
    </div>
    <InboxMock />
  </div>

  {/* The four audiences */}
  <div class="mt-12 grid gap-6 md:grid-cols-2">
    {
      t.useCases.items.map((u, i) => (
        <div
          data-reveal
          style={`--reveal-delay:${(i % 2) * 90}ms`}
          class="group flex gap-5 rounded-3xl border border-border-soft bg-surface p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-border-strong hover:shadow-lifted sm:p-8"
        >
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-iris/10 text-iris transition-colors duration-300 group-hover:bg-[image:var(--gradient-brand)] group-hover:text-white">
            <Icon name={`lucide:${u.icon}`} class="h-6 w-6" />
          </span>
          <div>
            <h3 class="text-lg font-semibold text-foreground">{u.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{u.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</Section>
