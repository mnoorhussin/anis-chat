---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import SourcesMock from '@components/mocks/SourcesMock.astro';
import InstallMock from '@components/mocks/InstallMock.astro';
import ChatMock from '@components/ui/ChatMock.astro';
import { getLangFromUrl, getDict } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
const chat = t.hero.chat;
---

<Section id="how" class="border-y border-border-soft bg-surface-2/40">
  <SectionHeading eyebrow={t.how.eyebrow} title={t.how.title} lead={t.how.lead} />

  <div class="mt-16 flex flex-col gap-16 sm:gap-24">
    {
      t.how.steps.map((s, i) => {
        const reverse = i % 2 === 1;
        return (
          <div class="grid items-center gap-8 md:grid-cols-2 md:gap-14">
            <div
              data-reveal
              class:list={['order-2', reverse ? 'md:order-2' : 'md:order-1']}
            >
              <div class="flex items-center gap-3">
                <span class="font-display text-4xl font-bold text-gradient">{s.step}</span>
                <span class="h-px w-12 bg-border-strong" />
              </div>
              <h3 class="mt-5 text-2xl font-semibold text-foreground">{s.title}</h3>
              <p class="mt-3 max-w-md text-lg leading-relaxed text-muted">{s.body}</p>
            </div>

            <div
              data-reveal
              style="--reveal-delay:120ms"
              class:list={['order-1', reverse ? 'md:order-1' : 'md:order-2']}
            >
              {i === 0 && <SourcesMock />}
              {i === 1 && <InstallMock />}
              {i === 2 && (
                <div class="mx-auto max-w-sm">
                  <ChatMock
                    lang={lang}
                    header={chat.header}
                    status={chat.status}
                    inputPlaceholder={chat.inputPlaceholder}
                    messages={[
                      { from: 'user', text: chat.customer },
                      { from: 'agent', text: chat.agent },
                    ]}
                  />
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</Section>
