---
import { Icon } from 'astro-icon/components';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { getLangFromUrl, getDict } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
const painIcons = ['lucide:trending-down', 'lucide:moon', 'lucide:layers'];
---

<Section id="problem">
  <SectionHeading
    eyebrow={t.problem.eyebrow}
    title={t.problem.title}
    lead={t.problem.lead}
    class="max-w-3xl"
  />

  <div class="mt-16 grid gap-6 md:grid-cols-3">
    {
      t.problem.pains.map((p, i) => (
        <div
          data-reveal
          style={`--reveal-delay:${i * 90}ms`}
          class="rounded-3xl border border-border-soft bg-surface p-8 shadow-soft"
        >
          <div class="grid h-12 w-12 place-items-center rounded-2xl bg-surface-2 text-muted">
            <Icon name={painIcons[i]} class="h-6 w-6" />
          </div>
          <h3 class="mt-5 text-lg font-semibold text-foreground">{p.title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{p.body}</p>
        </div>
      ))
    }
  </div>

  {/* The promise */}
  <div
    data-reveal
    class="relative mt-8 overflow-hidden rounded-4xl border border-white/10 bg-ink px-6 py-14 text-white sm:px-14 sm:py-20"
  >
    <div
      class="pointer-events-none absolute -end-24 -top-24 h-80 w-80 rounded-full opacity-70"
      style="background: radial-gradient(circle, rgba(90,90,240,0.4), transparent 65%);"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-24 -start-24 h-80 w-80 rounded-full opacity-60"
      style="background: radial-gradient(circle, rgba(55,224,200,0.3), transparent 65%);"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto flex max-w-2xl flex-col items-center text-center">
      <span
        class="grid h-14 w-14 place-items-center rounded-2xl bg-[image:var(--gradient-brand)] shadow-glow-iris"
      >
        <Icon name="lucide:sparkles" class="h-7 w-7 text-white" />
      </span>
      <span
        class:list={[
          'mt-6 text-sm font-semibold text-gradient',
          lang === 'ar' ? '' : 'uppercase tracking-wider',
        ]}
      >
        {t.solution.eyebrow}
      </span>
      <h2 class="mt-3 text-display-md font-semibold text-white text-balance">{t.solution.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-white/65">{t.solution.lead}</p>
    </div>
  </div>
</Section>
