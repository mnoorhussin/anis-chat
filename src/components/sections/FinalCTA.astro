---
import LeadForm from '@components/forms/LeadForm.astro';
import { getLangFromUrl, getDict } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
const c = t.finalCta;
---

<section id="waitlist" class="scroll-mt-24 py-20 sm:py-28">
  <div class="container-page">
    <div
      data-reveal
      class="relative isolate overflow-hidden rounded-[2rem] border border-white/10 bg-ink px-6 py-16 text-white sm:px-14 sm:py-24"
    >
      {/* gradient mesh */}
      <div
        class="pointer-events-none absolute -start-24 -top-24 h-96 w-96 rounded-full opacity-70"
        style="background: radial-gradient(circle, rgba(90,90,240,0.42), transparent 65%);"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-32 -end-20 h-[26rem] w-[26rem] rounded-full opacity-60"
        style="background: radial-gradient(circle, rgba(55,224,200,0.3), transparent 65%);"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style="background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 54px 54px; -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 40%, #000 30%, transparent 100%); mask-image: radial-gradient(ellipse 70% 70% at 50% 40%, #000 30%, transparent 100%);"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto flex max-w-2xl flex-col items-center text-center">
        <span
          class:list={[
            'text-sm font-semibold text-gradient',
            lang === 'ar' ? '' : 'uppercase tracking-wider',
          ]}
        >
          {c.eyebrow}
        </span>
        <h2 class="mt-3 text-display-lg font-semibold text-white text-balance">{c.title}</h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/70">{c.lead}</p>

        <LeadForm source="final-cta" tone="dark" class="mt-9" />
      </div>
    </div>
  </div>
</section>
