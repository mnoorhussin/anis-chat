---
import LeadForm from '@components/forms/LeadForm.astro';
import { getLangFromUrl, getDict } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
const c = t.finalCta;
---

{/* The one dark band on the light page — the majlis after sunset. */}
<section id="waitlist" class="scroll-mt-24 py-20 sm:py-28">
  <div class="container-page">
    <div
      data-reveal
      class="relative isolate overflow-hidden rounded-3xl bg-espresso px-6 py-16 text-cream sm:px-14 sm:py-24"
      style="background-color: #1c1610; color: #f4ecdd;"
    >
      {/* double manuscript rule, top */}
      <div class="pointer-events-none absolute inset-x-10 top-6" aria-hidden="true">
        <div style="border-top: 1px solid rgba(244,236,221,0.28);"></div>
        <div class="mt-[3px]" style="border-top: 1px solid rgba(244,236,221,0.12);"></div>
      </div>

      <div class="relative mx-auto flex max-w-2xl flex-col items-center text-center">
        <span
          class:list={[
            'inline-flex items-center gap-2.5 text-sm font-semibold',
            lang === 'ar' ? '' : 'uppercase tracking-wider',
          ]}
          style="color: #e3a84e;"
        >
          <span class="ijam" aria-hidden="true"><i></i><i></i><i></i></span>
          {c.eyebrow}
        </span>
        <h2 class="mt-3 text-display-lg font-semibold text-balance" style="color: #f4ecdd;">{c.title}</h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed" style="color: rgba(244,236,221,0.75);">{c.lead}</p>

        <LeadForm source="final-cta" tone="dark" class="mt-9" />
      </div>
    </div>
  </div>
</section>
