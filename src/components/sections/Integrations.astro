---
import { Icon } from 'astro-icon/components';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';
import { getLangFromUrl, getDict } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);

// Brand/platform names are proper nouns — shown untranslated in both locales.
// `soon: true` = not yet live; shown dimmed with a "Soon" badge so we never
// imply a channel works before its onboarding flow is operational.
const integrations = [
  { name: 'WordPress', icon: 'simple-icons:wordpress', soon: false },
  { name: 'Shopify', icon: 'simple-icons:shopify', soon: false },
  { name: 'WooCommerce', icon: 'simple-icons:woocommerce', soon: false },
  { name: 'Wix', icon: 'simple-icons:wix', soon: false },
  { name: 'Webflow', icon: 'simple-icons:webflow', soon: false },
  { name: 'Squarespace', icon: 'simple-icons:squarespace', soon: false },
  { name: 'Custom API', icon: 'lucide:code-xml', soon: false },
  { name: 'WhatsApp', icon: 'simple-icons:whatsapp', soon: true },
  { name: 'Messenger', icon: 'simple-icons:messenger', soon: true },
  { name: 'Instagram', icon: 'simple-icons:instagram', soon: true },
  { name: 'Telegram', icon: 'simple-icons:telegram', soon: true },
  { name: 'Slack', icon: 'simple-icons:slack', soon: true },
];
---

<Section id="integrations" class="border-y border-border-soft bg-surface-2/50">
  <SectionHeading eyebrow={t.integrations.eyebrow} title={t.integrations.title} lead={t.integrations.lead} />

  <div class="mx-auto mt-14 grid max-w-4xl grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    {
      integrations.map((it, i) => (
        <div
          data-reveal
          style={`--reveal-delay:${(i % 4) * 70}ms`}
          class:list={[
            'flex items-center gap-3 rounded-2xl border px-5 py-4 shadow-soft transition-colors duration-200',
            it.soon
              ? 'border-dashed border-border-soft bg-surface/60'
              : 'border-border-soft bg-surface hover:border-border-strong',
          ]}
        >
          <Icon name={it.icon} class:list={['h-6 w-6 shrink-0', it.soon ? 'text-subtle' : 'text-foreground']} />
          <span class:list={['truncate text-sm font-medium', it.soon ? 'text-muted' : 'text-foreground']}>
            {it.name}
          </span>
          {it.soon && (
            <span class="ms-auto shrink-0 rounded-full bg-surface-3 px-2 py-0.5 text-[10px] font-medium text-subtle">
              {t.integrations.soon}
            </span>
          )}
        </div>
      ))
    }
  </div>

  <div data-reveal class="mt-10 flex justify-center">
    <Button href="#waitlist" variant="outline" size="md" trailingArrow>{t.integrations.cta}</Button>
  </div>
</Section>
