---
import { Icon } from 'astro-icon/components';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';
import { getLangFromUrl, getDict, formatCurrency } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
const p = t.pricing;

const tiers = p.tiers.map((tier) => {
  const yearly = tier.priceMonthly * 10; // 2 months free
  return {
    ...tier,
    popular: tier.id === 'pro',
    monthlyLabel: formatCurrency(tier.priceMonthly, lang),
    annualLabel: formatCurrency(Math.round(yearly / 12), lang),
    yearlyLabel: formatCurrency(yearly, lang),
  };
});
---

<Section id="pricing">
  <SectionHeading eyebrow={p.eyebrow} title={p.title} lead={p.lead} />

  <div data-pricing data-billing="monthly" class="mt-12">
    {/* Billing toggle */}
    <div class="flex justify-center">
      <div class="inline-flex items-center gap-1 rounded-full border border-border-soft bg-surface-2 p-1">
        <button
          type="button"
          data-bill="monthly"
          class="rounded-full px-5 py-2 text-sm font-medium text-muted transition-colors"
        >
          {p.monthly}
        </button>
        <button
          type="button"
          data-bill="annual"
          class="inline-flex items-center gap-2 rounded-full px-5 py-2 text-sm font-medium text-muted transition-colors"
        >
          {p.annual}
          <span class="rounded-full bg-aqua/15 px-2 py-0.5 text-xs font-semibold text-aqua">{p.annualNote}</span>
        </button>
      </div>
    </div>

    {/* Tiers */}
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        tiers.map((tier, i) => (
          <div
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
            class:list={[
              'relative flex flex-col rounded-3xl border bg-surface p-8 transition-all duration-300',
              tier.popular
                ? 'border-transparent ring-gradient shadow-glow-iris lg:-translate-y-3'
                : 'border-border-soft shadow-soft',
            ]}
          >
            {tier.popular && (
              <span class="absolute inset-x-0 -top-3.5 mx-auto w-fit rounded-full bg-[image:var(--gradient-brand)] px-3.5 py-1 text-xs font-semibold text-white shadow-glow-iris">
                {p.mostPopular}
              </span>
            )}
            <h3 class="text-lg font-semibold text-foreground">{tier.name}</h3>
            <p class="mt-2 min-h-[2.75rem] text-sm leading-relaxed text-muted">{tier.tagline}</p>

            <div class="mt-5 flex items-end gap-1">
              <span class="font-display text-5xl font-bold tracking-tight text-foreground">
                <span data-price-monthly>{tier.monthlyLabel}</span>
                <span data-price-annual>{tier.annualLabel}</span>
              </span>
              <span class="mb-1.5 text-sm text-muted">{p.perMonth}</span>
            </div>
            <p class="mt-1.5 h-4 text-xs text-subtle">
              <span data-note-annual>{tier.yearlyLabel} {p.billedAnnually}</span>
            </p>

            <div class="mt-6">
              <Button
                href="#waitlist"
                variant={tier.popular ? 'primary' : 'outline'}
                class="w-full justify-center"
              >
                {tier.cta}
              </Button>
            </div>

            <ul class="mt-8 flex flex-col gap-3.5">
              {tier.features.map((feat) => (
                <li class="flex items-start gap-3 text-sm text-foreground">
                  <Icon
                    name="lucide:check"
                    class="mt-0.5 h-4 w-4 shrink-0 text-aqua"
                    aria-hidden="true"
                  />
                  <span class="text-muted">{feat}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* Enterprise */}
    <div
      data-reveal
      class="mt-6 flex flex-col gap-6 rounded-3xl border border-border-soft bg-surface-2/60 p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10"
    >
      <div class="max-w-xl">
        <h3 class="text-xl font-semibold text-foreground">{p.enterprise.name}</h3>
        <p class="mt-2 leading-relaxed text-muted">{p.enterprise.tagline}</p>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          {
            p.enterprise.features.map((feat) => (
              <li class="flex items-center gap-2 text-sm text-muted">
                <Icon name="lucide:check" class="h-4 w-4 shrink-0 text-aqua" aria-hidden="true" />
                {feat}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex shrink-0 flex-col items-start gap-3 sm:items-end">
        <span class="font-display text-3xl font-bold text-foreground">{p.enterprise.priceLabel}</span>
        <Button href={`mailto:hello@anis.chat`} variant="secondary" trailingArrow>
          {p.enterprise.cta}
        </Button>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Monthly by default: annual price + annual note hidden. */
  [data-pricing] [data-price-annual],
  [data-pricing] [data-note-annual] {
    display: none;
  }
  [data-pricing][data-billing='annual'] [data-price-annual],
  [data-pricing][data-billing='annual'] [data-note-annual] {
    display: inline;
  }
  [data-pricing][data-billing='annual'] [data-price-monthly] {
    display: none;
  }
  [data-pricing] [data-bill].is-active {
    background: var(--surface);
    color: var(--foreground);
    box-shadow: var(--shadow-soft);
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-pricing]');
    if (!root) return;
    var btns = root.querySelectorAll('[data-bill]');
    function set(mode) {
      root.setAttribute('data-billing', mode);
      btns.forEach(function (b) {
        b.classList.toggle('is-active', b.getAttribute('data-bill') === mode);
      });
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        set(b.getAttribute('data-bill'));
      });
    });
    set('monthly');
  })();
</script>
