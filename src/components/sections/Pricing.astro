---
import { Icon } from 'astro-icon/components';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';
import { getLangFromUrl, getDict } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
const p = t.pricing;

const money = (n: number) => `$${n.toLocaleString('en-US')}`;

const tiers = p.tiers.map((tier) => {
  const yearly = tier.price * 10; // 2 months free
  return {
    ...tier,
    popular: tier.highlight === 'popular',
    agency: tier.highlight === 'agency',
    monthlyLabel: money(tier.price),
    annualLabel: money(Math.round(yearly / 12)),
    yearlyLabel: money(yearly),
  };
});
---

<Section id="pricing">
  <SectionHeading eyebrow={p.eyebrow} title={p.title} lead={p.lead} />

  <div data-pricing data-billing="monthly" class="mt-12">
    {/* Billing toggle */}
    <div class="flex justify-center">
      <div class="inline-flex items-center gap-1 rounded-full border border-border-soft bg-surface-2 p-1">
        <button type="button" data-bill="monthly" class="rounded-full px-5 py-2 text-sm font-medium text-muted transition-colors">
          {p.monthly}
        </button>
        <button type="button" data-bill="annual" class="inline-flex items-center gap-2 rounded-full px-5 py-2 text-sm font-medium text-muted transition-colors">
          {p.annual}
          <span class="rounded-full bg-oasis/15 px-2 py-0.5 text-xs font-semibold text-oasis">{p.annualNote}</span>
        </button>
      </div>
    </div>

    {/* Tiers */}
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {
        tiers.map((tier, i) => (
          <div
            data-reveal
            style={`--reveal-delay:${(i % 5) * 70}ms`}
            class:list={[
              'relative flex flex-col rounded-3xl border bg-surface p-6 transition-all duration-300',
              tier.popular
                ? 'border-transparent ring-gradient shadow-glow-oasis xl:-translate-y-2'
                : tier.agency
                  ? 'border-oasis/30 shadow-soft'
                  : 'border-border-soft shadow-soft',
            ]}
          >
            {tier.popular && (
              <span class="absolute inset-x-0 -top-3.5 mx-auto w-fit rounded-full bg-oasis px-3.5 py-1 text-xs font-semibold text-cream shadow-glow-oasis">
                {p.mostPopular}
              </span>
            )}
            <h3 class="text-base font-semibold text-foreground">{tier.name}</h3>
            <p class="mt-1.5 min-h-[2.5rem] text-[13px] leading-relaxed text-muted">{tier.tagline}</p>

            <div class="mt-4 flex items-end gap-1">
              <span class="font-display text-4xl font-bold tracking-tight text-foreground">
                <span data-price-monthly>{tier.monthlyLabel}</span>
                <span data-price-annual>{tier.price === 0 ? tier.monthlyLabel : tier.annualLabel}</span>
              </span>
              {tier.price > 0 && <span class="mb-1.5 text-sm text-muted">{p.perMonth}</span>}
            </div>
            <p class="mt-1 h-4 text-xs text-subtle">
              {tier.price > 0 && <span data-note-annual>{tier.yearlyLabel} {p.billedAnnually}</span>}
            </p>

            <div class="mt-5">
              <Button
                href="#waitlist"
                variant={tier.popular ? 'primary' : tier.agency ? 'secondary' : 'outline'}
                size="sm"
                class="w-full justify-center"
              >
                {tier.cta}
              </Button>
            </div>

            <ul class="mt-6 flex flex-col gap-2.5">
              {tier.features.map((feat) => (
                <li class="flex items-start gap-2.5 text-[13px]">
                  <Icon name="lucide:check" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-oasis" aria-hidden="true" />
                  <span class="text-muted">{feat}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* Add-on + billing controls */}
    <div class="mt-6 grid gap-4 lg:grid-cols-[1fr_1.4fr]">
      <div class="flex flex-col justify-center rounded-3xl border border-border-soft bg-surface-2/60 p-6">
        <h3 class="text-base font-semibold text-foreground">{p.addonTitle}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{p.addonText}</p>
      </div>
      <ul class="grid gap-x-6 gap-y-2.5 rounded-3xl border border-border-soft bg-surface-2/60 p-6 sm:grid-cols-2">
        {
          p.notes.map((note) => (
            <li class="flex items-start gap-2.5 text-[13px] text-muted">
              <Icon name="lucide:shield-check" class="mt-0.5 h-4 w-4 shrink-0 text-oasis" aria-hidden="true" />
              {note}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style>
  [data-pricing][data-billing='monthly'] [data-price-annual],
  [data-pricing][data-billing='monthly'] [data-note-annual] {
    display: none;
  }
  [data-pricing][data-billing='annual'] [data-price-monthly] {
    display: none;
  }
  [data-pricing][data-billing='annual'] [data-price-annual] {
    display: inline;
  }
  [data-pricing][data-billing='annual'] [data-note-annual] {
    display: inline;
  }
  [data-pricing] [data-bill].is-active {
    background: var(--surface);
    color: var(--foreground);
    box-shadow: var(--shadow-soft);
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-pricing]');
    if (!root) return;
    var btns = root.querySelectorAll('[data-bill]');
    function set(mode) {
      root.setAttribute('data-billing', mode);
      btns.forEach(function (b) {
        b.classList.toggle('is-active', b.getAttribute('data-bill') === mode);
      });
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        set(b.getAttribute('data-bill'));
      });
    });
    set('monthly');
  })();
</script>
