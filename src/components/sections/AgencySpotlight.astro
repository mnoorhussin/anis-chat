---
import { Icon } from 'astro-icon/components';
import Section from '@components/ui/Section.astro';
import Button from '@components/ui/Button.astro';
import AgencyMock from '@components/mocks/AgencyMock.astro';
import { getLangFromUrl, getDict } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
const a = t.agency;
const isAr = lang === 'ar';
---

<Section id="agencies" class="relative overflow-hidden border-y border-border-soft bg-surface-2/40">
  <div
    class="pointer-events-none absolute inset-y-0 -z-10 w-[36rem] rounded-full opacity-60 ltr:right-0 rtl:left-0"
    style="background: radial-gradient(ellipse at center, rgba(90,90,240,0.14), transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    {/* Copy */}
    <div data-reveal class="flex flex-col items-start">
      <span
        class:list={[
          'inline-flex items-center gap-2 text-sm font-semibold text-gradient',
          !isAr && 'uppercase tracking-wider',
        ]}
      >
        {a.eyebrow}
      </span>
      <h2 class="mt-4 text-display-lg font-semibold text-foreground text-balance">{a.title}</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">{a.text}</p>

      <ul class="mt-8 grid gap-x-6 gap-y-3 sm:grid-cols-2">
        {
          a.bullets.map((b) => (
            <li class="flex items-start gap-2.5 text-sm text-foreground">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-aqua/15 text-aqua">
                <Icon name="lucide:check" class="h-3 w-3" />
              </span>
              <span class="text-muted">{b}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-9">
        <Button href="#waitlist" size="lg" trailingArrow>{a.cta}</Button>
      </div>
    </div>

    {/* Visual */}
    <div data-reveal style="--reveal-delay:120ms" class="relative">
      <div
        class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] opacity-80"
        style="background: radial-gradient(ellipse at 50% 30%, rgba(55,224,200,0.16), transparent 60%);"
        aria-hidden="true"
      >
      </div>
      <AgencyMock class="mx-auto max-w-md lg:ms-auto" />
    </div>
  </div>
</Section>
