---
import { Icon } from 'astro-icon/components';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import DashboardMock from '@components/mocks/DashboardMock.astro';
import { getLangFromUrl, getDict } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
const ps = t.productShowcase;
---

<Section id="dashboard" class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-x-0 top-1/4 -z-10 mx-auto h-[34rem] max-w-5xl rounded-full opacity-70"
    style="background: radial-gradient(ellipse at center, rgba(90,90,240,0.16), transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <SectionHeading eyebrow={ps.eyebrow} title={ps.title} lead={ps.lead} />

  <div data-reveal class="relative mx-auto mt-14 max-w-5xl">
    {/* soft glow behind the window */}
    <div
      class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] opacity-80"
      style="background: radial-gradient(ellipse at 50% 0%, rgba(55,224,200,0.18), transparent 60%);"
      aria-hidden="true"
    >
    </div>
    <DashboardMock />
  </div>

  <ul class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-3">
    {
      ps.bullets.map((b, i) => (
        <li
          data-reveal
          style={`--reveal-delay:${i * 90}ms`}
          class="flex items-start gap-3 rounded-2xl border border-border-soft bg-surface p-4 shadow-soft"
        >
          <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-aqua/15 text-aqua">
            <Icon name="lucide:check" class="h-3.5 w-3.5" />
          </span>
          <span class="text-sm leading-relaxed text-muted">{b}</span>
        </li>
      ))
    }
  </ul>
</Section>
