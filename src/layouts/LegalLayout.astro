---
import PageLayout from './PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, getDict } from '@i18n/utils';
import type { LegalDoc } from '@i18n/legal';

interface Props {
  doc: LegalDoc;
}
const { doc } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = getDict(lang);
const backLabel = lang === 'ar' ? 'العودة إلى الرئيسية' : 'Back to home';
---

<PageLayout title={doc.title} description={doc.intro}>
  <div class="container-page pb-24 pt-32 sm:pt-40">
    <article class="mx-auto max-w-3xl">
      <a
        href={`/${lang}/`}
        class="inline-flex items-center gap-2 text-sm font-medium text-muted transition-colors hover:text-foreground"
      >
        <Icon name="lucide:arrow-left" class="h-4 w-4 rtl:-scale-x-100" />
        {backLabel}
      </a>

      <h1 class="mt-8 text-display-md font-bold text-foreground">{doc.title}</h1>
      <p class="mt-3 text-sm text-subtle">{doc.updated}</p>
      <p class="mt-6 text-lg leading-relaxed text-muted">{doc.intro}</p>

      <div class="mt-12 flex flex-col gap-10">
        {
          doc.sections.map((s) => (
            <section>
              <h2 class="text-xl font-semibold text-foreground">{s.heading}</h2>
              {s.body.map((p) => (
                <p class="mt-3 leading-relaxed text-muted">{p}</p>
              ))}
            </section>
          ))
        }
      </div>

      <p class="mt-16 border-t border-border-soft pt-8 text-sm text-subtle">
        {t.footer.madeWith} · <a href="mailto:hello@anis.chat" class="text-iris hover:underline">hello@anis.chat</a>
      </p>
    </article>
  </div>
</PageLayout>
