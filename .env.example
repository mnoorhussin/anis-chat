# Copy to `.env` and fill in before launch. All PUBLIC_ vars are exposed to the client.

# Lead capture — Formspree form ID (https://formspree.io). Without it, forms
# fall back to a mailto: link to hello@anis.chat.
PUBLIC_FORMSPREE_ID=

# Privacy-friendly analytics — your Plausible domain (e.g. anis.chat).
# Analytics load ONLY after the visitor grants consent in the cookie banner.
# Leave empty to disable analytics entirely.
PUBLIC_PLAUSIBLE_DOMAIN=
